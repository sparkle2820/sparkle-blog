---
import { ClientRouter } from 'astro:transitions';
import ScrollCord from '../components/ScrollCord.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  /** 页头初始透明浮在整屏图上（首页与文章页） */
  transparentHeader?: boolean;
}

const {
  title = "Sparkle's Blog",
  description = '记录机器人、工程实践与生活里的灵光。',
  image = '/media/2026/04/1.jpg',
  article = false,
  transparentHeader = false,
} = Astro.props;

const pageTitle = title === "Sparkle's Blog" ? title : `${title} | Sparkle`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c0d12" />
    <meta name="description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Sparkle's Blog" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Sparkle's Blog RSS" href="/rss.xml" />
    <link rel="icon" type="image/png" href="/media/2026/04/cropped-cropped-cropped-1-e1776522665125.png" />
    <title>{pageTitle}</title>

    <ClientRouter />

    <!-- 没有 JS 时，滚动进场的元素必须照常可见 -->
    <noscript>
      <style>
        [data-reveal],
        [data-reveal] img {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <ScrollCord />
    <SiteHeader currentPath={Astro.url.pathname} transparent={transparentHeader} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 每次换页前把上一页注册的滚动监听整批撤掉，避免叠加
      let listeners = new AbortController();

      document.addEventListener('astro:before-swap', () => {
        listeners.abort();
        listeners = new AbortController();
      });

      /** 把 rAF 节流的滚动回调挂上去，随换页自动清理 */
      function onScroll(handler: () => void) {
        let ticking = false;

        const schedule = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            handler();
            ticking = false;
          });
        };

        window.addEventListener('scroll', schedule, { passive: true, signal: listeners.signal });
        window.addEventListener('resize', schedule, { passive: true, signal: listeners.signal });
        handler();
      }

      function initReveal() {
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

        if (reduceMotion) {
          targets.forEach((element) => element.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );

        targets.forEach((element) => observer.observe(element));
      }

      /** 全幅图带的缓慢视差 */
      function initParallax() {
        if (reduceMotion) return;

        const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
        if (targets.length === 0) return;

        onScroll(() => {
          const viewportHeight = window.innerHeight;

          for (const element of targets) {
            const parent = element.parentElement;
            if (!parent) continue;

            const rect = parent.getBoundingClientRect();
            if (rect.bottom < -200 || rect.top > viewportHeight + 200) continue;

            const strength = Number(element.dataset.parallax) || 10;
            const centre = rect.top + rect.height / 2 - viewportHeight / 2;
            const shift = (centre / viewportHeight) * -strength;
            element.style.transform = `translate3d(0, ${shift.toFixed(2)}%, 0)`;
          }
        });
      }

      /** 首屏文字随滚动上移淡出，做出景深 */
      function initHeroExit() {
        if (reduceMotion) return;

        const hero = document.querySelector<HTMLElement>('[data-hero-exit]');
        if (!hero) return;

        onScroll(() => {
          const progress = Math.min(1, window.scrollY / (window.innerHeight * 0.85));
          hero.style.opacity = String(1 - progress);
          hero.style.transform = `translate3d(0, ${(progress * -56).toFixed(1)}px, 0)`;
        });
      }

      function init() {
        initReveal();
        initParallax();
        initHeroExit();
      }

      // ClientRouter 在首次加载时也会派发 astro:page-load，所以这里不用再手动调一次
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
