---
import { ArrowLeft } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这个页面没有找到。">
  <section class="not-found">
    <div>
      <p class="eyebrow">404</p>
      <h1>这里没有页面</h1>
      <p>链接可能已经更改，或者它从未存在过 —— 就像忘掉的那个名字。</p>
      <a class="btn btn-primary" href="/"><ArrowLeft size={18} stroke-width={2} /> 返回首页</a>
    </div>
  </section>
</BaseLayout>
