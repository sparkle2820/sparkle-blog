---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="搜索 Sparkle 博客中的文章。">
  <header class="page-hero" data-pagefind-ignore>
    <div class="section-shell">
      <p class="eyebrow">Search</p>
      <h1>搜索</h1>
      <p>在全部文章的正文里找关键词。</p>
    </div>
  </header>

  <section class="search-section" data-pagefind-ignore>
    <div class="section-shell search-shell">
      <div id="search"></div>
    </div>
  </section>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    // 用 astro:page-load 而不是 DOMContentLoaded —— 开了 View Transitions 之后，
    // 软导航过来时 DOMContentLoaded 不会再触发。
    document.addEventListener('astro:page-load', () => {
      const mount = document.querySelector('#search');
      if (!mount || mount.dataset.booted === 'true') return;
      mount.dataset.booted = 'true';

      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: true,
        translations: {
          placeholder: '搜索文章',
          clear_search: '清除',
          load_more: '加载更多',
          search_label: '站内搜索',
          filters_label: '筛选',
          zero_results: '没有找到 “[SEARCH_TERM]”',
          many_results: '找到 [COUNT] 条结果',
          one_result: '找到 1 条结果'
        }
      });
    });
  </script>
</BaseLayout>
