---
interface Props {
  /** stars = 夜空星点 + 偶发流星；sparks = 极淡的暖色浮尘 */
  variant?: 'stars' | 'sparks';
}

const { variant = 'stars' } = Astro.props;
---

<canvas class="star-canvas" data-star-canvas={variant} aria-hidden="true"></canvas>

<script>
  type Variant = 'stars' | 'sparks';

  interface Star {
    x: number;
    y: number;
    r: number;
    base: number;
    phase: number;
    speed: number;
  }

  interface Mote {
    x: number;
    y: number;
    r: number;
    vx: number;
    vy: number;
    alpha: number;
  }

  interface Streak {
    x: number;
    y: number;
    len: number;
    progress: number;
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** 换页时要拆掉的清理函数 */
  let teardowns: Array<() => void> = [];

  document.addEventListener('astro:before-swap', () => {
    for (const teardown of teardowns) teardown();
    teardowns = [];
  });

  function boot(canvas: HTMLCanvasElement) {
    const context = canvas.getContext('2d');
    if (!context) return;

    const variant = (canvas.dataset.starCanvas as Variant) ?? 'stars';
    const stars: Star[] = [];
    const motes: Mote[] = [];
    let streak: Streak | null = null;
    let nextStreakAt = performance.now() + 3000;
    let width = 0;
    let height = 0;
    let frame = 0;
    let visible = false;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context!.setTransform(ratio, 0, 0, ratio, 0, 0);
      seed();
    }

    function seed() {
      stars.length = 0;
      motes.length = 0;

      // 密度按面积走，克制为主
      const density = Math.round((width * height) / 16000);

      if (variant === 'stars') {
        for (let i = 0; i < Math.min(density, 110); i += 1) {
          stars.push({
            x: Math.random() * width,
            y: Math.random() * height,
            r: Math.random() * 1.05 + 0.3,
            base: Math.random() * 0.34 + 0.16,
            phase: Math.random() * Math.PI * 2,
            speed: Math.random() * 0.0014 + 0.0005,
          });
        }
      } else {
        for (let i = 0; i < Math.min(density, 48); i += 1) {
          motes.push(spawnMote(Math.random() * height));
        }
      }
    }

    function spawnMote(y: number): Mote {
      return {
        x: Math.random() * width,
        y,
        r: Math.random() * 1.2 + 0.4,
        vx: (Math.random() - 0.5) * 0.09,
        vy: -(Math.random() * 0.18 + 0.04),
        alpha: Math.random() * 0.32 + 0.12,
      };
    }

    function drawStars(time: number) {
      for (const star of stars) {
        const alpha = star.base + Math.sin(time * star.speed + star.phase) * 0.2;
        context!.globalAlpha = Math.max(0.04, Math.min(1, alpha));
        context!.fillStyle = '#ffffff';
        context!.beginPath();
        context!.arc(star.x, star.y, star.r, 0, Math.PI * 2);
        context!.fill();
      }

      if (reduceMotion) return;

      if (!streak && time > nextStreakAt) {
        streak = {
          x: width * (0.55 + Math.random() * 0.5),
          y: height * (Math.random() * 0.3),
          len: 90 + Math.random() * 70,
          progress: 0,
        };
      }

      if (!streak) return;

      streak.progress += 0.012;
      const travel = streak.progress * (width * 0.85);
      const headX = streak.x - travel;
      const headY = streak.y + travel * 0.4;
      const tailX = headX + streak.len;
      const tailY = headY - streak.len * 0.4;
      const fade = Math.sin(Math.min(1, streak.progress) * Math.PI);

      const gradient = context!.createLinearGradient(headX, headY, tailX, tailY);
      gradient.addColorStop(0, `rgba(255, 255, 255, ${0.72 * fade})`);
      gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

      context!.globalAlpha = 1;
      context!.strokeStyle = gradient;
      context!.lineWidth = 1.3;
      context!.lineCap = 'round';
      context!.beginPath();
      context!.moveTo(headX, headY);
      context!.lineTo(tailX, tailY);
      context!.stroke();

      if (streak.progress >= 1) {
        streak = null;
        nextStreakAt = time + 5000 + Math.random() * 7000;
      }
    }

    function drawMotes() {
      for (const mote of motes) {
        if (!reduceMotion) {
          mote.x += mote.vx;
          mote.y += mote.vy;
          if (mote.y < -6) Object.assign(mote, spawnMote(height + 6));
        }

        context!.globalAlpha = mote.alpha;
        context!.fillStyle = '#ffe7cc';
        context!.beginPath();
        context!.arc(mote.x, mote.y, mote.r, 0, Math.PI * 2);
        context!.fill();
      }
    }

    function render(time: number) {
      context!.clearRect(0, 0, width, height);
      if (variant === 'stars') drawStars(time);
      else drawMotes();
      context!.globalAlpha = 1;

      // 静态偏好下只画一帧
      if (visible && !reduceMotion) frame = requestAnimationFrame(render);
      else frame = 0;
    }

    function start() {
      if (frame) cancelAnimationFrame(frame);
      frame = requestAnimationFrame(render);
    }

    function stop() {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    }

    const resizeObserver = new ResizeObserver(() => {
      resize();
      if (visible) start();
    });
    resizeObserver.observe(canvas);

    // 只在进入视口时跑动画
    const viewObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          visible = entry.isIntersecting;
          if (visible) start();
          else stop();
        }
      },
      { rootMargin: '120px' },
    );
    viewObserver.observe(canvas);

    resize();

    teardowns.push(() => {
      stop();
      resizeObserver.disconnect();
      viewObserver.disconnect();
    });
  }

  function initStarCanvases() {
    document.querySelectorAll<HTMLCanvasElement>('[data-star-canvas]').forEach(boot);
  }

  document.addEventListener('astro:page-load', initStarCanvases);
</script>
